+
+pkgname=skia
+pkgver=6a75afe9792764f6faa76ad50125781899ca05e8
+pkgrel=0
+pkgdesc="Skia 2D graphics library"
+url="https://skia.org/"
+archs=("arm64-v8a")
+license=("BSD-3-Clause")
+depends=()
+makedepends=("python3" "curl" "tar")
+
+source="https://github.com/google/skia/archive/${pkgver}.tar.gz"
+downloadpackage=true
+autounpack=true
+buildtools="gn"
+
+builddir=skia-${pkgver}
+packagename=${pkgver}.tar.gz
+
+if [ -n "${LYCIUM_ROOT:-}" ] && [ -f "${LYCIUM_ROOT}/script/envset.sh" ]; then
+    source "${LYCIUM_ROOT}/script/envset.sh"
+else
+    source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/lycium/script/envset.sh"
+fi
+
+SKIA_LIB_OUT=out/ohos-lib
+SKIA_TOOLS_OUT=out/ohos-tools
+
+prepare() {
+    if [ "$ARCH" != "arm64-v8a" ]; then
+        echo "unsupported arch: $ARCH"
+        return -1
+    fi
+
+    setarm64ENV
+
+    cd "$builddir"
+
+    python3 bin/fetch-gn >> "$buildlog" 2>&1
+    python3 bin/fetch-ninja >> "$buildlog" 2>&1
+
+    mkdir -p "$SKIA_LIB_OUT" "$SKIA_TOOLS_OUT"
+    cd "$OLDPWD"
+}
+
+build() {
+    cd "$builddir"
+
+    local lib_args
+    lib_args='cc="'"$CC"'" cxx="'"$CXX"'" ar="'"$AR"'" target_os="linux" target_cpu="arm64" is_official_build=true is_debug=false is_component_build=true skia_use_ohos=true skia_use_fontconfig=false skia_use_freetype=false skia_use_expat=false skia_use_x11=false skia_use_egl=false skia_use_gl=false skia_use_vulkan=false skia_use_perfetto=false skia_enable_pdf=false skia_enable_svg=false skia_enable_skottie=false skia_use_icu=false skia_use_zlib=false skia_use_libpng_decode=false skia_use_libpng_encode=false skia_use_libwebp_decode=false skia_use_libwebp_encode=false skia_use_libjpeg_turbo_decode=false skia_use_libjpeg_turbo_encode=false skia_use_wuffs=false skia_use_dng_sdk=false skia_use_piex=false skia_use_harfbuzz=false extra_cflags=["-DOHOS_NDK","-D__MUSL__=1","-fPIC"] extra_cflags_cc=["-std=c++17"]'
+    bin/gn gen "$SKIA_LIB_OUT" --args="$lib_args" >> "$buildlog" 2>&1
+    third_party/ninja/ninja -C "$SKIA_LIB_OUT" skia >> "$buildlog" 2>&1
+
+    local tools_args
+    tools_args='cc="'"$CC"'" cxx="'"$CXX"'" ar="'"$AR"'" target_os="linux" target_cpu="arm64" is_official_build=true is_debug=false is_component_build=false skia_compile_modules=false skia_enable_tools=true skia_use_ohos=true skia_use_fontconfig=false skia_use_freetype=false skia_use_expat=false skia_use_x11=false skia_use_egl=true skia_use_gl=true skia_use_vulkan=false skia_use_perfetto=false skia_enable_pdf=false skia_enable_svg=false skia_enable_skottie=false skia_use_icu=false skia_use_zlib=false skia_use_libpng_decode=false skia_use_libpng_encode=false skia_use_libwebp_decode=false skia_use_libwebp_encode=false skia_use_libjpeg_turbo_decode=false skia_use_libjpeg_turbo_encode=false skia_use_wuffs=false skia_use_dng_sdk=false skia_use_piex=false skia_use_harfbuzz=false extra_cflags=["-DOHOS_NDK","-D__MUSL__=1","-fPIC"] extra_cflags_cc=["-std=c++17"]'
+    bin/gn gen "$SKIA_TOOLS_OUT" --args="$tools_args" >> "$buildlog" 2>&1
+    third_party/ninja/ninja -C "$SKIA_TOOLS_OUT" sksl-minify ohos_egl_smoke >> "$buildlog" 2>&1
+
+    cd "$OLDPWD"
+}
+
+package() {
+    cd "$builddir"
+
+    mkdir -p "${LYCIUM_ROOT}/usr/${pkgname}/${ARCH}/lib"
+    mkdir -p "${LYCIUM_ROOT}/usr/${pkgname}/${ARCH}/bin"
+
+    cp -f "$SKIA_LIB_OUT/libskia.so" "${LYCIUM_ROOT}/usr/${pkgname}/${ARCH}/lib/"
+    cp -f "$SKIA_TOOLS_OUT/sksl-minify" "${LYCIUM_ROOT}/usr/${pkgname}/${ARCH}/bin/"
+    cp -f "$SKIA_TOOLS_OUT/ohos_egl_smoke" "${LYCIUM_ROOT}/usr/${pkgname}/${ARCH}/bin/"
+
+    cd "$OLDPWD"
+    unsetarm64ENV
+}
+
+check() {
+    echo "The test must be on an OpenHarmony device!"
+    return 0
+}
+
+cleanbuild() {
+    rm -rf "${PWD}/${builddir}"
+}
